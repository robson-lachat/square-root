  }

  if ($testPrintFuncname == 1) {print "Exiting  $FUNCNAME\n"; }
  exit $exitStatus;

# -----------------------------------------------------------------------------
# FUNCTION DEFINITION
# -----------------------------------------------------------------------------
sub getItemTypeDF () {

  local $item = @_[0];
  local $itemTypeDF;

#  chomp $item;

  if (-f $item) { 
    $itemTypeDF = $FILE;
  }
  elsif (-d $item) { 
    $itemTypeDF = $DIR;
  }
  elsif (-l $item) { # We enter this case when the link is to an absent file!
    $itemTypeDF = $FILE;
  }
  else {
    print "********************* WARNING ************************\n";
    print "Unexpected item encountered (expecting file or dir):<$item>\n";
    print "Exiting $FUNCNAME\n";
    print "********************* WARNING ************************\n";
    exit 3;
  }
  return $itemTypeDF;
}

