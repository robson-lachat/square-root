# -----------------------------------------------------------------------------
# Build a table that is the union of the two directories' contents:
# 
# typeDUCS  typeDF     nameStr               dirIfUniq    name            count
# --------- ------  -----------------------  ---------  ---------------   -----
# common     dir          dir_tmp               X       dir_tmp             2
# same       file         common_log.txt        X	common_log.txt      2
# unique     dir    dir_1/unique_dir          dir_1     unique_dir          1
# unique     file   dir_1/unique_to_dir_1     dir_2     unique_to_dir_1     1
# different  file         different_date.fits   X	different_date.fits 2
#
# |<-------- Used in the output ----------->|<------ working variables ------>|
#
# Table "union" will be built in several steps.
# -----------------------------------------------------------------------------
  $exitStatus = 0;

# Get itemFindListD1 and D2
  @itemFindListD1 = `cd $d1; find . -follow`;
  @itemFindListD2 = `cd $d2; find . -follow`;

# Step 1: Populate name, dirIfUniq and initialize count.
  foreach $item (@itemFindListD1) {
    chomp $item;
    $itemInfo = {
      name      => $item,
      dirIfUniq => $d1,
      count     => 0,
    };
    $union{$item}= $itemInfo;
  }

  foreach $item (@itemFindListD2) {
    chomp $item;
    $itemInfo = {
      name      => $item,
      dirIfUniq => $d2,
      count     => 0,
    };
    $union{$item}= $itemInfo;
  }

# Step 2: count is calculated
  foreach $item (@itemFindListD1, @itemFindListD2) {
    $union{$item}->{name} =~s/^\.\///g;  # strip leading ./ in name
    $union{$item}->{count}++;            # count occurences to get uniq/common
    $union{$item}->{typeDF}=&getItemTypeDF("$union{$item}->{dirIfUniq}/$item");
  }

# Step 3: figure out the two types (DUCS and DF) and nameStr.
  foreach $item (keys %union) {

    if ($union{$item}->{count} == 1) {
      $union{$item}->{typeDUCS} = $UNIQ;
      $union{$item}->{nameStr}  = $union{$item}->{dirIfUniq}."/"
                                . $union{$item}->{name};
      $exitStatus = 1;
    }  # endif 1_unique

    elsif ($union{$item}->{count} == 2) {
      $union{$item}->{nameStr}  = $union{$item}->{name};
      if ($union{$item}->{typeDF} eq $DIR) {
        $union{$item}->{typeDUCS} = $COMM;
      }
      else {  # it is a file

        $f1 = $d1."/".$union{$item}->{name};
        $f2 = $d2."/".$union{$item}->{name};
        $sizeF1 = -s $f1;
        $sizeF2 = -s $f2;
        if ($sizeF1 != $sizeF2) {  # must be different since size is different
          $union{$item}->{typeDUCS} = $DIFF;
          $exitStatus = 1;
        }
        else {  # must do cmp since size does not confirm anything
          $res = `cmp $f1 $f2 2> /dev/null`;
          $status=$?/256;
          if ($status == 0) {
            $union{$item}->{typeDUCS} = $SAME;
          }
          elsif ($status == 1) {
            $union{$item}->{typeDUCS} = $DIFF;
            $exitStatus = 1;
#           print "\ncmp diff  detected:\n $f1 \n $f2    $status\n";
          }
          else {
            if ((! -e $f1) && (! -e $f2)) {
              $union{$item}->{typeDUCS} = $SAME;
            }
            else {
              print "********************* WARNING ************************\n";
              print "Unexpected cmp error encountered with files\n";
              print "<$f1>\n";
              print "<$f2>\n";
              print "Exiting $FUNCNAME\n";
              print "********************* WARNING ************************\n";
              exit 3;
            }
          }  # endif same/diff


        }    # endif dir/file
      }      # endif size different
    }        # endif 2_common

    else {
      print "********************* WARNING ************************\n";
      printf "Unexpected number of occurences found (%d instead of 1 or 2)\n",
             $union{$item}->{count};
      print "Exiting $FUNCNAME\n";
      print "********************* WARNING ************************\n";
      exit 3;
    }  # endif 1_uniq/2_common/unexpected
  }    # next item in d1 d2 lists

# Sort the result


# -----------------------------------------------------------------------------
# Print output to screen
# -----------------------------------------------------------------------------
  @sortedItems = sort {$union{$a}->{typeDUCS} cmp $union{$b}->{typeDUCS}}  
                 (keys %union);

# Perhaps not the best way of sorting the order of appearance ...
  @sortedItems = sort {$union{$a}->{typeDUCS}.
                       $union{$a}->{typeDF}  .
                       $union{$a}->{nameStr}     cmp
                       $union{$b}->{typeDUCS}.
                       $union{$b}->{typeDF}  .
                       $union{$b}->{nameStr}  } (keys %union);

  foreach $item (@sortedItems) {
    printf "%s  %s  %s\n", 
           $union{$item}->{typeDUCS},
